{
    "name": "ps14/ps14_component",
    "type": "typo3-cms-extension",
    "description": "Reusable Fluid components for TYPO3 projects based on ps14_foundation.",
    "keywords": [
        "TYPO3",
        "extension",
        "fluid",
        "components"
    ],
    "homepage": "https://ps14.de/",
    "license": "proprietary",
    "authors": [
        {
            "name": "Christian Pschorr",
            "email": "pschorr.christian@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ps14/ps14_foundation": "@dev",
        "typo3/cms-core": "^14.3",
        "typo3/cms-fluid": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "Ps14\\Component\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ps14_component"
        },
        "branch-alias": {
            "dev-main": "14.0.x-dev"
        }
    }
}
